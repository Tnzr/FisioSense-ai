{
  "name": "asculto-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Asculto offline desktop app (Electron + ONNX Runtime)",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "fetch-models": "node scripts/fetch-models.mjs",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "onnxruntime-node": "^1.20.1"
  },
  "build": {
    "appId": "ai.asculto.desktop",
    "productName": "Asculto",
    "files": ["main.js", "preload.js", "renderer/**", "models/**"],
    "extraResources": [{ "from": "../frontend/dist", "to": "renderer" }],
    "publish": [{ "provider": "github", "releaseType": "release" }],
    "mac": { "category": "public.app-category.medical", "hardenedRuntime": true },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Science" }
  }
}
